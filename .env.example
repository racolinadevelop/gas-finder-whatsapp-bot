# Environment: development, test, or production.
APP_ENV=development

GOOGLE_MAPS_API_KEY=

# Cost control: at most 1-3 Places Text Search pages (20 candidates/page).
# Default 2 instead of 3; fewer pages may omit cheaper/distant stations.
GOOGLE_TEXT_MAX_PAGES=2

# Optional paid Routes API (separate from Places); disabled until explicitly
# enabled in Google Cloud AND on Railway. One request per search, billed by
# number of destinations (matrix elements), capped at 5.
ROUTES_API_ENABLED=false
ROUTES_MAX_DESTINATIONS=5

# Gas-station data provider: google or here.
GAS_STATION_PROVIDER=google
HERE_API_KEY=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
INTERNAL_API_TOKEN=

# Keep API documentation enabled locally. Set false in production.
API_DOCS_ENABLED=true

# Optional AI fallback. It stays disabled unless explicitly enabled.
AI_INTENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional shared state for Railway. Without this, local development uses memory.
REDIS_URL=
REDIS_KEY_PREFIX=gas-finder
CONVERSATION_TTL_SECONDS=604800
WHATSAPP_DEDUP_TTL_SECONDS=86400

# Per-user protection for real gas-station searches.
SEARCH_RATE_LIMIT_MAX=10
SEARCH_RATE_LIMIT_WINDOW_SECONDS=300

# Optional locally; use Railway PostgreSQL in production for subscriptions.
DATABASE_URL=
